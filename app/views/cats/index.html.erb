<p style="color: green"><%= notice %></p>

<% content_for :title, "Cats" %>

<div class="container mt-4">
  <h1 class="mb-4">Cats</h1>

  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">検索</h5>
      <%= search_form_for @q, class: "mb-3" do |f| %>
        <div class="row g-3">
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :name_cont, "名前" %>
              <%= f.search_field :name_cont, class: "form-control" %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :age_gteq, "年齢（以上）" %>
              <%= f.number_field :age_gteq, class: "form-control" %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <%= f.label :age_lteq, "年齢（以下）" %>
              <%= f.number_field :age_lteq, class: "form-control" %>
            </div>
          </div>
          <div class="col-12">
            <%= f.submit "検索", class: "btn btn-primary" %>
            <%= link_to "リセット", cats_path, class: "btn btn-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-end mb-3">
    <%= link_to new_cat_path, class: "btn btn-primary" do %>
      <i class="bi bi-plus-circle-fill me-1"></i>登録
    <% end %>
  </div>

  <div id="cats" class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th><%= sort_link(@q, :id, 'ID') %></th>
          <th><%= sort_link(@q, :name, '名前') %></th>
          <th><%= sort_link(@q, :age, '年齢') %></th>
          <th class="text-end">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @cats.each do |cat| %>
          <tr>
            <td><%= cat.id %></td>
            <td><%= cat.name %></td>
            <td><%= cat.age %></td>
            <td class="text-end">
              <div class="d-flex gap-2 justify-content-end">
                <%= link_to "編集", edit_cat_path(cat), class: "btn btn-sm btn-outline-primary" %>
                <%= button_to "削除", cat_path(cat), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "本当に削除しますか？" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 mb-4">
    <%= paginate @cats %>
  </div>
</div>
