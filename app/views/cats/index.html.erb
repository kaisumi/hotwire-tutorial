<p style="color: green"><%= notice %></p>

<% content_for :title, "Cats" %>

<h1>Cats</h1>

<div id="cats">
  <% @cats.each do |cat| %>
    <%= render cat %>
    <p>
      <%= link_to "Show this cat", cat %>
    </p>
  <% end %>
</div>

<div class="mt-4">
  <%= paginate @cats %>
</div>

<div class="mt-3">
  <%= link_to "New cat", new_cat_path, class: "btn btn-primary" %>
</div>
